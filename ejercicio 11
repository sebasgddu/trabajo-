#include <iostream>

using namespace std;

void leerVector(float v[], int n);
void contarTipos(const float v[], int n, int &pos, int &neg, int &ceros);
void mostrarConteo(int pos, int neg, int ceros);

int main() {
    int n;

    do {
        cout << "Ingrese la cantidad de elementos (n > 0): ";
        cin >> n;
    } while (n <= 0);

    float vector[100];
    int pos = 0, neg = 0, ceros = 0;

    leerVector(vector, n);
    contarTipos(vector, n, pos, neg, ceros);
    mostrarConteo(pos, neg, ceros);

    return 0;
}

void leerVector(float v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Elemento [" << i << "]: ";
        cin >> v[i];
    }
}

void contarTipos(const float v[], int n, int &pos, int &neg, int &ceros) {
    pos = 0;
    neg = 0;
    ceros = 0;

    for (int i = 0; i < n; i++) {
        if (v[i] > 0) {
            pos++;
        } else if (v[i] < 0) {
            neg++;
        } else {
            ceros++;
        }
    }
}

void mostrarConteo(int pos, int neg, int ceros) {
    cout << "\n--- RESULTADOS DEL CONTEO ---" << endl;
    cout << "Cantidad de numeros positivos: " << pos << endl;
    cout << "Cantidad de numeros negativos: " << neg << endl;
    cout << "Cantidad de ceros: " << ceros << endl;
}
