#include <iostream>

using namespace std;

void leerVector(float v[], int n);
void calcularPromediosConsecutivos(const float A[], float P[], int n);
void mostrarPromedios(const float P[], int cantidadPromedios);

int main() {
    int n;
    do {
        cout << "Ingrese la cantidad de elementos (n >= 3): ";
        cin >> n;
    } while (n < 3);

    float A[100];
    float P[98]; // n - 2 elementos máximo para n <= 100

    leerVector(A, n);
    calcularPromediosConsecutivos(A, P, n);
    mostrarPromedios(P, n - 2);

    return 0;
}

void leerVector(float v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "A[" << i << "]: ";
        cin >> v[i];
    }
}

void calcularPromediosConsecutivos(const float A[], float P[], int n) {
    for (int i = 0; i < n - 2; i++) {
        P[i] = (A[i] + A[i + 1] + A[i + 2]) / 3.0f;
    }
}

void mostrarPromedios(const float P[], int cantidadPromedios) {
    cout << "\nPromedios de 3 elementos consecutivos:" << endl;
    for (int i = 0; i < cantidadPromedios; i++) {
        cout << "P" << (i + 1) << " = " << P[i] << endl;
    }
}
