#include <iostream>

using namespace std;

int leerTamano();
void generarFibonacci(unsigned long long fib[], int n);
void mostrarFibonacci(const unsigned long long fib[], int n);

int main() {
    int n = leerTamano();
    
    // Soporta hasta n = 93 sin desbordamiento usando unsigned long long
    unsigned long long fib[100];

    generarFibonacci(fib, n);
    mostrarFibonacci(fib, n);

    return 0;
}

int leerTamano() {
    int n;
    do {
        cout << "Ingrese la cantidad de terminos de Fibonacci (1 <= n <= 90): ";
        cin >> n;
    } while (n <= 0 || n > 90);
    return n;
}

void generarFibonacci(unsigned long long fib[], int n) {
    if (n >= 1) fib[0] = 0;
    if (n >= 2) fib[1] = 1;

    for (int i = 2; i < n; i++) {
        fib[i] = fib[i - 1] + fib[i - 2];
    }
}

void mostrarFibonacci(const unsigned long long fib[], int n) {
    cout << "\nLos primeros " << n << " terminos de la serie de Fibonacci son:" << endl;
    for (int i = 0; i < n; i++) {
        cout << "F" << i << " = " << fib[i] << endl;
    }
}
