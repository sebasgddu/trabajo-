#include <iostream>
using namespace std;
void LeerNumero(int v[], int n);
void MostrarNumero(int v[], int n);
float obtnerMaximo(int v[], int n); 
int main (){
    int n=0;
    while(n<=0||n>100){
        cout<<"el valor ingresado debe estar entre 1 y 100";
        cin>>n;
    }
    int vector[100];
    LeerNumero(vector,n);
    MostrarNumero(vector,n);
    float maximo=obtnerMaximo(vector, n);
    cout<<"el valor maximo de vector:"<<maximo<<endl;
    return 0;
}
void LeerNumero (int v[],int n){
     for (int i=0;i<n;i++){
         cout<<"ingrese el valor de ["<< i <<"]";
         cin>>v[i];
     }
    
}
void MostrarNumero(int v[],int n){
    for (int i=0;i<n;i++){
        cout<<v[i]<<" ";
    }cout<<endl;}
    
float obtnerMaximo (int v[], int n) {
    float maximo=v[0];
    for (int i=1;i<n;i++){
    if (v[i]>maximo)
    {maximo=v[i];} }
 return maximo;
}          
