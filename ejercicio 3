#include <iostream>

using namespace std;

void leer(float v[], int n);
float calcularPromedio(const float v[], int n);
void mostrar(float promedio);

int main() {
    int n;
    do {
        cout << "Ingrese la cantidad de elementos (n > 0): ";
        cin >> n;
    } while (n <= 0);

    float vector[100];
    leer(vector, n);
    float promedio = calcularPromedio(vector, n);
    mostrar(promedio);

    return 0;
}

void leer(float v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Elemento [" << i << "]: ";
        cin >> v[i];
    }
}

float calcularPromedio(const float v[], int n) {
    float suma = 0;
    for (int i = 0; i < n; i++) {
        suma += v[i];
    }
    return suma / n;
}

void mostrar(float promedio) {
    cout << "El promedio del vector es: " << promedio << endl;
}
